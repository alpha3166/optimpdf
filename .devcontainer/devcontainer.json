{
	"name": "optimpdf",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"installMaven": true
		}
	},
	"onCreateCommand": "sudo apt-get update -y && sudo apt-get install -y imagemagick",
	"customizations": {
		"vscode": {
			"extensions": [
				"DavidAnson.vscode-markdownlint",
				"DotJoshJohnson.xml",
				"ms-azuretools.vscode-containers"
			]
		}
	}
}